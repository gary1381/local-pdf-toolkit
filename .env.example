# Copy to .env (used by docker compose and by the gateway when run locally).

# Who can reach the editor. 127.0.0.1 = this computer only (recommended).
# To serve your network: BIND_ADDR=0.0.0.0, set API_KEY, and add this
# machine's name or IP to ALLOWED_HOSTS.
BIND_ADDR=127.0.0.1
ALLOWED_HOSTS=127.0.0.1,localhost
API_KEY=

# Largest file accepted, in MB.
MAX_UPLOAD_MB=200

# Editing sessions (kept on disk so they survive restarts).
SESSION_DIR=/data/sessions
SESSION_TTL_HOURS=168
SESSION_MAX_TOTAL_MB=4096
SESSION_HISTORY=40

# Service addresses when running the gateway outside containers
OCR_URL=http://127.0.0.1:8091
PDFBOX_URL=http://127.0.0.1:8092
QPDF_URL=http://127.0.0.1:8093

# MCP client
PDF_GATEWAY_URL=http://127.0.0.1:8090
PDF_GATEWAY_API_KEY=
