    "linux": {
      "deb": {
        "depends": ["libstdc++6", "zlib1g", "libgmp10", "libfreetype6", "fontconfig"],
        "section": "text",
        "desktopTemplate": "../../packaging/linux/openpdf.desktop"
      }
    }
  }
}
