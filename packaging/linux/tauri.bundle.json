{
  "bundle": {
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "resources": {
      "../../packaging/build/backend/": "backend/"
    },
    "shortDescription": "PDF viewer and editor",
    "longDescription": "OpenPDF: read, annotate, fill, sign, merge and split PDF files. Chinese and English text recognition (OCR) is an optional add-on downloaded on first use.",
