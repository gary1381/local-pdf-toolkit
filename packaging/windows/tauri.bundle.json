{
  "mainBinaryName": "OpenPDF",
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../packaging/build/backend/": "backend/"
    },
    "publisher": "OpenPDF",
    "shortDescription": "PDF viewer and editor",
    "longDescription": "OpenPDF: read, annotate, fill, sign, merge and split PDF files on your own computer. Text recognition (OCR) is an optional add-on downloaded on first use.",
    "category": "Productivity",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German",
          "French",
          "Spanish",
          "Japanese",
          "Korean",
          "SimpChinese",
          "TradChinese"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "en-US"
        ]
      }
    }
  }
}
